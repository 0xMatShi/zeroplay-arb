# Application
APP_NAME=arb-be
APP_VERSION=1.0.0
APP_PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=arb_be

# SIWE Configuration
APP_DOMAIN=localhost
APP_ORIGIN=http://localhost:5173
SIWE_CHAIN_ID=1
SIWE_STATEMENT=Sign in with Ethereum to the app.

# Predict.fun API key (mainnet: https://api.predict.fun, request via Discord)
# Without key the adapter will use testnet with limited data
PREDICT_FUN_API_KEY=

# Admin API key for trigger/management endpoints
ADMIN_API_KEY=

# Telegram bot secret — must match BOT_SECRET in payment-bot/.env
BOT_SECRET=

# Payment Configuration
PAYMENT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
PAYMENT_POLL_INTERVAL_MS=20000

# Blockchain RPC URLs (only configured chains will be monitored)
ETHEREUM_RPC_URL=
BSC_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=

# Block confirmations per chain (optional, defaults shown)
ETHEREUM_CONFIRMATIONS=12
BSC_CONFIRMATIONS=15
ARBITRUM_CONFIRMATIONS=5
BASE_CONFIRMATIONS=5

OPENROUTER_API_KEY=
AI_VERIFICATION_MODEL=
